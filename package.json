{
  "name": "carrot-manga-translator",
  "version": "1.6.3",
  "description": "Windows and Apple Silicon macOS desktop manga translation, editing, and inpainting tool powered by Gemma 4 and OpenAI Codex.",
  "license": "GPL-3.0-only",
  "type": "commonjs",
  "main": "out/main/bootstrap.js",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "node scripts/build.cjs",
    "dist:win": "node scripts/dist-win-thin.cjs",
    "dist:win:nvidia": "node scripts/dist-win-thin.cjs --with-flux-nvidia",
    "dist:win:amd": "node scripts/dist-win-thin.cjs",
    "build:mac:runners": "node scripts/build-mac-runners.cjs",
    "test:flux-metal": "node scripts/test-flux-metal.cjs",
    "prepare:mac:runtime": "node scripts/prepare-mac-runtime.cjs",
    "dist:mac:alpha": "node scripts/dist-mac-alpha.cjs",
    "verify:mac:package": "node scripts/verify-mac-package.cjs",
    "build:flux-rocm-runtime": "node scripts/build-flux-rocm-runtime.cjs",
    "compile:electron": "node scripts/compile-electron.cjs",
    "logs": "node scripts/tail-log.cjs",
    "typecheck": "tsc --noEmit",
    "typecheck:js": "tsc -p tsconfig.checkjs.json",
    "typecheck:js-strict-budget": "node scripts/check-js-strict-budget.cjs",
    "lint": "eslint .",
    "lint:budget": "node scripts/check-lint-budget.cjs",
    "lint:error-handling": "node scripts/check-error-handling.cjs",
    "arch:deps": "depcruise --config .dependency-cruiser.cjs --include-only \"^src\" src",
    "arch:budget": "node scripts/check-architecture-budget.cjs",
    "check:renderer-bundle": "node scripts/check-renderer-bundle-boundary.cjs",
    "check:preload-bundle": "node scripts/check-preload-bundle-boundary.cjs",
    "clean:generated": "node scripts/clean-generated.cjs",
    "check:generated": "node scripts/check-generated-clean.cjs",
    "deadcode": "knip --files --dependencies --no-config-hints",
    "deadcode:exports": "knip --config knip.exports.json --exports --no-config-hints",
    "test": "vitest run",
    "check": "npm run typecheck && npm run typecheck:js && npm run typecheck:js-strict-budget && npm run format:check && npm run lint && npm run lint:budget && npm run lint:error-handling && npm run arch:deps && npm run arch:budget && npm run check:generated && npm run deadcode && npm run deadcode:exports && npm test && npm run build && node scripts/run-image-protocol-smoke.cjs && npm run check:renderer-bundle && npm run check:preload-bundle",
    "prepack": "npm run check:generated",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "npm run build && node scripts/preview.cjs",
    "smoke:overlay": "npm run build && node scripts/run-smoke-overlay.cjs",
    "smoke:image-protocol": "npm run build && node scripts/run-image-protocol-smoke.cjs",
    "qa:ui": "node scripts/ui-qa.mjs",
    "verify:hf-assets": "node scripts/verify-hf-assets.cjs",
    "perf:gemma-economy": "npm run build && node scripts/run-gemma-economy-benchmark.cjs"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "i18next": "^26.3.6",
    "tar": "^7.5.7",
    "yauzl": "^3.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@eslint/js": "^10.0.1",
    "@radix-ui/react-progress": "^1.1.8",
    "@tabler/icons-react": "^3.44.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.0.2",
    "app-builder-lib": "^26.8.1",
    "dependency-cruiser": "^17.4.3",
    "electron": "43.1.1",
    "electron-builder": "^26.8.1",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "ffmpeg-static": "5.3.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "knip": "^6.15.0",
    "openai-oauth": "^1.0.2",
    "prettier": "^3.8.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-i18next": "^17.0.9",
    "rolldown": "^1.0.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
