{
  "name": "carrot-manga-translator",
  "version": "1.13.1",
  "description": "Open-source desktop OCR, AI translation, editing and inpainting tool for user-provided manga and comic images.",
  "license": "GPL-3.0-only",
  "type": "commonjs",
  "main": "./out/main/bootstrap.js",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "node scripts/build.cjs",
    "dist:win": "node scripts/dist-win-thin.cjs",
    "dist:win:nvidia": "node scripts/dist-win-thin.cjs --with-flux-nvidia",
    "dist:win:amd": "node scripts/dist-win-thin.cjs",
    "build:mac:runners": "node scripts/build-mac-runners.cjs",
    "test:flux-metal": "node scripts/test-flux-metal.cjs",
    "prepare:mac:runtime": "node scripts/prepare-mac-runtime.cjs",
    "dist:mac": "node scripts/dist-mac-alpha.cjs --stable",
    "dist:mac:alpha": "node scripts/dist-mac-alpha.cjs",
    "verify:mac:package": "node scripts/verify-mac-package.cjs",
    "build:flux-rocm-runtime": "node scripts/build-flux-rocm-runtime.cjs",
    "compile:electron": "node scripts/compile-electron.cjs",
    "logs": "node scripts/tail-log.cjs",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "typecheck:electron": "tsc -p tsconfig.electron-typecheck.json",
    "typecheck:js": "tsc -p tsconfig.checkjs.json",
    "typecheck:js-strict-budget": "npm run typecheck:js",
    "lint": "eslint . --max-warnings 0 --cache --cache-strategy content --cache-location .tmp/check-cache/eslint",
    "lint:budget": "npm run lint",
    "lint:error-handling": "node scripts/check-error-handling.cjs",
    "check:test-mock-boundaries": "node scripts/check-test-mock-boundaries.cjs",
    "arch:deps": "depcruise --config .dependency-cruiser.cjs --include-only \"^src\" src",
    "arch:budget": "node scripts/check-architecture-budget.cjs",
    "arch:check": "node scripts/check-architecture.cjs",
    "check:reexports": "node scripts/check-reexport-boundaries.cjs",
    "check:renderer-bundle": "node scripts/check-renderer-bundle-boundary.cjs",
    "check:preload-bundle": "node scripts/check-preload-bundle-boundary.cjs",
    "clean:generated": "node scripts/clean-generated.cjs",
    "check:generated": "node scripts/check-generated-clean.cjs",
    "check:css-structure": "node scripts/check-css-structure.cjs",
    "check:script-entrypoints": "node scripts/check-script-entrypoints.cjs",
    "deadcode": "knip --config knip.config.cjs --files --dependencies --no-config-hints",
    "deadcode:exports": "knip --config knip.exports.json --exports --no-config-hints",
    "prepare:electron": "node node_modules/electron/install.js",
    "pretest": "npm run prepare:electron",
    "pretest:coverage": "npm run prepare:electron",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:production-cleanup-coverage": "node scripts/check-production-cleanup-coverage.cjs",
    "test:workers:soak": "node scripts/soak-vitest-workers.cjs --iterations 10",
    "check": "node scripts/check.cjs",
    "check:cached-build": "node scripts/check-with-build-cache.cjs",
    "check:cold": "node scripts/check.cjs --cold",
    "prepack": "npm run check:generated",
    "format": "node scripts/run-prettier.cjs --write",
    "format:check": "node scripts/run-prettier.cjs --check",
    "preview": "npm run build && node scripts/preview.cjs",
    "smoke:overlay": "npm run build && node scripts/run-smoke-overlay.cjs",
    "smoke:image-protocol": "npm run build && node scripts/run-image-protocol-smoke.cjs",
    "smoke:flux-pattern": "node scripts/run-flux-pattern-smoke.cjs",
    "qa:ui": "node scripts/ui-qa.mjs",
    "qa:library-fonts": "node scripts/run-library-full-pipeline-qa.cjs",
    "build:font-face-manifest": "node scripts/build-font-face-manifest.cjs",
    "check:font-face-manifest": "node scripts/build-font-face-manifest.cjs --check",
    "build:font-render-bank": "node scripts/build-font-render-bank.cjs",
    "check:font-render-bank": "node scripts/build-font-render-bank.cjs --check",
    "qa:page-artwork-parity": "npm run compile:electron && node scripts/run-page-artwork-pixel-parity.cjs",
    "qa:page-artwork-parity:from-build": "node scripts/run-page-artwork-pixel-parity.cjs",
    "qa:page-artwork-parity:hardware": "npm run compile:electron && node scripts/run-page-artwork-pixel-parity.cjs --hardware",
    "verify:hf-assets": "node scripts/verify-hf-assets.cjs",
    "perf:gemma-economy": "npm run build && node scripts/run-gemma-economy-benchmark.cjs"
  },
  "dependencies": {
    "ag-psd": "^31.0.2",
    "i18next": "^26.3.6",
    "onnxruntime-web": "1.27.0",
    "pngjs": "^7.0.0",
    "tar": "^7.5.7",
    "yauzl": "^3.4.0",
    "yazl": "3.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@eslint/js": "^10.0.1",
    "@radix-ui/react-progress": "^1.1.8",
    "@tabler/icons-react": "^3.44.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.0.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.9",
    "adm-zip": "^0.6.0",
    "app-builder-lib": "^26.15.3",
    "dependency-cruiser": "^17.4.3",
    "electron": "43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "ffmpeg-static": "5.3.0",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "knip": "^6.15.0",
    "openai-oauth": "^1.0.2",
    "prettier": "^3.8.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-i18next": "^17.0.9",
    "rolldown": "^1.0.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
