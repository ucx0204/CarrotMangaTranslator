{
  "$schema": "./node_modules/knip/schema.json",
  "entry": [
    "src/main/bootstrap.ts",
    "src/main/index.ts",
    "src/preload/index.ts",
    "src/renderer/src/main.tsx",
    "src/renderer/src/pageExport/browserEntry.tsx",
    "tests/pageArtworkPixelParityPanelEntry.tsx",
    "scripts/page-artwork-pixel-parity/electron-runner.cjs",
    "tests/**/*.test.{ts,tsx}",
    "scripts/**/*.{cjs,mjs,js}"
  ],
  "project": [
    "src/**/*.{ts,tsx,js,cjs,mjs}",
    "tests/**/*.{ts,tsx,js,cjs,mjs}",
    "scripts/**/*.{ts,tsx,js,cjs,mjs}",
    "*.{ts,tsx,js,cjs,mjs}"
  ],
  "ignoreIssues": {
    "src/main/runtime/**/*.cjs": ["exports", "types", "nsExports", "nsTypes"],
    "src/shared/modelPresets.ts": ["duplicates"]
  }
}
