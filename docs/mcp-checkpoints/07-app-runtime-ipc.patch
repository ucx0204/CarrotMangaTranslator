diff --git a/src/main/mcp/mcpDesktopLease.ts b/src/main/mcp/mcpDesktopLease.ts
new file mode 100644
--- /dev/null
+++ b/src/main/mcp/mcpDesktopLease.ts
@@ -0,0 +1,179 @@
+import { randomBytes } from "node:crypto";
+import { oauthEqual } from "./mcpOAuthPolicy";
+import type { McpDesktopLease } from "../application/mcpDesktopService";
+import type {
+  McpPreferences,
+  McpDiagnostics,
+} from "../../shared/mcpDesktopTypes";
+import { McpPairingService } from "../application/mcpPairingService";
+import { McpOAuthProvider } from "./mcpOAuthProvider";
+import { McpOAuthSession } from "./mcpOAuthSession";
+import { McpOAuthHttp } from "./mcpOAuthHttp";
+import { McpPairingHttp } from "./mcpPairingHttp";
+import type { McpSecureStore } from "./mcpSecureStore";
+import { startMcpHttpServer } from "./mcpHttpServer";
+import type { McpTool } from "./mcpReadTools";
+import {
+  inspectMcpTailscale,
+  startMcpFunnel,
+  waitForMcpFunnel,
+  type McpTunnelLease,
+} from "./mcpTailscale";
+
+type Options = {
+  store: McpSecureStore;
+  preferences: McpPreferences;
+  tools: McpTool[];
+  signal: AbortSignal;
+  onSetup: (url: string) => void;
+  onFailure: (error: Error) => void;
+  reportError: (error: unknown) => void;
+};
+/** The same public issuer is restored before the listener becomes reachable. */
+export async function openMcpDesktopLease(
+  options: Options,
+): Promise<McpDesktopLease> {
+  const { origin, executable } = await inspectMcpTailscale(options.signal);
+  const state = await options.store.load();
+  options.signal.throwIfAborted();
+  const password = randomBytes(32).toString("base64url");
+  const provider = new McpOAuthProvider(origin, password, Date.now, {
+    persistent: true,
+    allowEdits: options.preferences.allowEditing,
+    allowImages: options.preferences.allowImages,
+  });
+  if (state.oauth) provider.restore(state.oauth);
+  const session = new McpOAuthSession(provider, {
+    save: (value) => options.store.saveAuthorization(value),
+  });
+  const pairing = new McpPairingService(provider, session, password);
+  const oauth = new McpOAuthHttp(
+    origin,
+    password,
+    session,
+    new McpPairingHttp(pairing),
+  );
+  const server = await startMcpHttpServer({
+    config: { port: 0, token: state.localToken, publicOrigin: origin },
+    oauth,
+    tools: options.tools,
+    reportError: options.reportError,
+    authorizeTool: (header, tool) =>
+      oauthEqual(header, `Bearer ${state.localToken}`) ||
+      oauth.accepts(header, tool.requiredScope ?? "carrot.read"),
+  });
+  let tunnel: McpTunnelLease | undefined;
+  const stop = () => {
+    server.stopAccepting();
+    pairing.close();
+  };
+  options.signal.addEventListener("abort", stop, { once: true });
+  let closing: Promise<void> | undefined;
+  const close = () => {
+    stop();
+    options.signal.removeEventListener("abort", stop);
+    closing ??= cleanup(server.close(), tunnel?.close());
+    return closing;
+  };
+  try {
+    options.signal.throwIfAborted();
+    tunnel = startMcpFunnel(
+      executable,
+      Number(new URL(server.url).port),
+      options.onSetup,
+      options.onFailure,
+    );
+    await waitForMcpFunnel(origin, options.signal);
+    return {
+      url: `${origin}/mcp`,
+      stopAccepting: stop,
+      close,
+      pairing: () => pairing.status(),
+      beginPairing: () => pairing.open(),
+      resolvePairing: (id, approved) => pairing.resolve(id, approved),
+      connections: () => provider.connections(),
+      revokeConnection: (id) =>
+        session.run(() => provider.revokeConnection(id)),
+      diagnose: () => diagnose(origin, server.url, state.localToken),
+    };
+  } catch (error) {
+    try {
+      await close();
+    } catch (cleanupError) {
+      throw new AggregateError(
+        [error, cleanupError],
+        "MCP startup and cleanup failed.",
+        { cause: cleanupError },
+      );
+    }
+    throw error;
+  }
+}
+async function cleanup(...tasks: (Promise<void> | undefined)[]): Promise<void> {
+  const results = await Promise.allSettled(tasks);
+  const failures = results.flatMap((result) =>
+    result.status === "rejected" ? [result.reason] : [],
+  );
+  if (failures.length)
+    throw new AggregateError(
+      failures,
+      "MCP listener or owned Funnel cleanup failed.",
+      { cause: failures[0] },
+    );
+}
+async function diagnose(
+  origin: string,
+  localUrl: string,
+  token: string,
+): Promise<McpDiagnostics> {
+  const checks: McpDiagnostics["checks"] = [];
+  async function check(name: string, probe: () => Promise<boolean>) {
+    try {
+      const passed = await probe();
+      checks.push({
+        name,
+        passed,
+        message: passed ? "PASS" : "Unexpected response",
+      });
+    } catch (_error) {
+      checks.push({
+        name,
+        passed: false,
+        message: "Connection failed. Check the app and Tailscale.",
+      });
+    }
+  }
+  const read = (url: string, init: RequestInit = {}) =>
+    fetch(url, {
+      ...init,
+      redirect: "error",
+      signal: AbortSignal.timeout(5000),
+    });
+  await check(
+    "Public HTTPS rejects unauthenticated access",
+    async () => (await read(`${origin}/mcp`)).status === 401,
+  );
+  await check("Public OAuth identity matches the fixed address", async () => {
+    const response = await read(
+      `${origin}/.well-known/oauth-protected-resource/mcp`,
+    );
+    return response.ok && (await response.json()).resource === `${origin}/mcp`;
+  });
+  await check("Authenticated repeated local MCP requests", async () => {
+    for (let id = 0; id < 3; id++) {
+      const response = await read(localUrl, {
+        method: "POST",
+        headers: {
+          Authorization: `Bearer ${token}`,
+          Accept: "application/json, text/event-stream",
+          "Content-Type": "application/json",
+        },
+        body: JSON.stringify({ jsonrpc: "2.0", id, method: "ping" }),
+      });
+      if (response.status !== 200 || (await response.json()).error)
+        return false;
+    }
+    return true;
+  });
+  return { ok: checks.every((item) => item.passed), checks };
+}
