@@ -0,0 +1,57 @@
+import { shell } from "electron";
+import { mcpIpcContracts } from "../../shared/ipcMcpContracts";
+import type { IpcContext } from "./context";
+import { trustedHandleContract } from "./trustedIpc";
+import { readTailscaleSetupUrl } from "../mcp/mcpTailscalePolicy";
+
+export function registerMcpIpc(context: IpcContext): void {
+  const control = () => {
+    if (!context.mcp) throw new Error("MCP control is unavailable.");
+    return context.mcp;
+  };
+  trustedHandleContract(context, mcpIpcContracts.getMcpStatus, () =>
+    control().getStatus(),
+  );
+  trustedHandleContract(
+    context,
+    mcpIpcContracts.setMcpEnabled,
+    (_event, enabled) => control().setEnabled(enabled),
+  );
+  trustedHandleContract(
+    context,
+    mcpIpcContracts.configureMcp,
+    (_event, preferences) => control().configure(preferences),
+  );
+  trustedHandleContract(context, mcpIpcContracts.beginMcpPairing, () =>
+    control().beginPairing(),
+  );
+  trustedHandleContract(
+    context,
+    mcpIpcContracts.resolveMcpPairing,
+    (_event, id, approved) => control().resolvePairing(id, approved),
+  );
+  trustedHandleContract(
+    context,
+    mcpIpcContracts.revokeMcpConnection,
+    (_event, id) => control().revokeConnection(id),
+  );
+  trustedHandleContract(context, mcpIpcContracts.diagnoseMcp, () =>
+    control().diagnose(),
+  );
+  trustedHandleContract(
+    context,
+    mcpIpcContracts.openMcpHelp,
+    async (_event, target) => {
+      if (target === "download")
+        await shell.openExternal("https://tailscale.com/download");
+      else if (target === "chatgpt")
+        await shell.openExternal("https://chatgpt.com");
+      else {
+        const url = (await control().getStatus()).setupUrl;
+        if (!url || readTailscaleSetupUrl(url) !== url)
+          throw new Error("No pending Tailscale setup page.");
+        await shell.openExternal(url);
+      }
+    },
+  );
+}
