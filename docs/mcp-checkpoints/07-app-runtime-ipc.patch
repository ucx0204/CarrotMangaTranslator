+import { McpDesktopService } from "./application/mcpDesktopService";
+import { rememberedMcpConnections } from "./mcp/mcpRememberedConnections";
+import { McpSecureStore } from "./mcp/mcpSecureStore";
+import { openMcpDesktopLease } from "./mcp/mcpDesktopLease";
+import { McpPageEditingService } from "./application/mcpPageEditingService";
+import { createMcpEditingTools } from "./mcp/mcpEditingTools";
+import { McpOperationError } from "./application/mcpOperationError";
+import { randomUUID } from "node:crypto";
+import type { AppActivityGate } from "./appActivityGate";
+import { listLibrary, openChapter, editPageBlocks } from "./library";
+import { createMcpToolSet } from "./mcp/mcpToolSet";
+import { renderMcpPagePreview } from "./mcp/mcpPreviewImage";
+
+export function createMcpDesktopRuntime(
+  dataRoot: string,
+  reportError: (error: unknown) => void,
+  activity: AppActivityGate,
+  notify: (chapterId: string, pageId: string) => void,
+): McpDesktopService {
+  const store = new McpSecureStore(dataRoot);
+  const editing = new McpPageEditingService({
+    openChapter,
+    editPageBlocks,
+    notify,
+    acquire: () => {
+      if (activity.isUnavailable)
+        throw new McpOperationError(
+          "APP_BUSY",
+          "Another app operation is active. Retry after it finishes.",
+        );
+      return activity.acquire({
+        id: randomUUID(),
+        category: "operation",
+        kind: "mcp-edit",
+        mutatesLibrary: true,
+        blocksQuit: true,
+      });
+    },
+  });
+  return new McpDesktopService({
+    remembered: (id) => rememberedMcpConnections(store, id),
+    preferences: () => store.preferences(),
+    savePreferences: (value) => store.savePreferences(value),
+    reportError,
+    open: (preferences, signal, onSetup, onFailure) => {
+      const tools = createMcpToolSet(
+        { listLibrary, openChapter },
+        preferences.allowImages ? renderMcpPagePreview : undefined,
+        true,
+        { allowEditing: preferences.allowEditing },
+      ).map((tool) => ({
+        ...tool,
+        requiredScope:
+          tool.name === "carrot_get_page_preview"
+            ? "carrot.images"
+            : "carrot.read",
+      }));
+      return openMcpDesktopLease({
+        store,
+        preferences,
+        tools: [
+          ...tools,
+          ...createMcpEditingTools(editing, preferences.allowEditing),
+        ],
+        signal,
+        onSetup,
+        onFailure,
+        reportError,
+      });
+    },
+  });
+}
