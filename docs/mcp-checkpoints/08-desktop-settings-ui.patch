diff --git a/src/renderer/src/hooks/useMcpChapterSync.ts b/src/renderer/src/hooks/useMcpChapterSync.ts
new file mode 100644
--- /dev/null
+++ b/src/renderer/src/hooks/useMcpChapterSync.ts
@@ -0,0 +1,28 @@
+import { useEffect, type MutableRefObject } from "react";
+import type { ChapterSnapshot } from "../../../shared/libraryTypes";
+import { mcpGateway } from "../api/mcpGateway";
+import { libraryGateway } from "../api/libraryGateway";
+import { createLiveChapterRefreshCoordinator } from "../lib/liveChapterRefreshCoordinator";
+/** Reuses the app's dirty-page-preserving live merge; never replaces a local unsaved draft. */
+export function useMcpChapterSync(
+  current: MutableRefObject<ChapterSnapshot | null>,
+  merge: (chapter: ChapterSnapshot) => void,
+  report: (message: string) => void,
+): void {
+  useEffect(() => {
+    const refresh = createLiveChapterRefreshCoordinator({
+      getCurrentChapterId: () => current.current?.id,
+      mergeLiveChapter: merge,
+      openChapter: libraryGateway.openChapter,
+      reportError: (error) =>
+        report(error instanceof Error ? error.message : "MCP refresh failed."),
+    });
+    const unsubscribe = mcpGateway.onMcpPageChanged((change) => {
+      if (change.chapterId === current.current?.id) refresh.request();
+    });
+    return () => {
+      unsubscribe();
+      refresh.dispose();
+    };
+  }, [current, merge, report]);
+}
