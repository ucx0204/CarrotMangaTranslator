+import React from "react";
+import { useTranslation } from "react-i18next";
+import { Button } from "../ui/Button";
+import { CheckboxField } from "../ui/CheckboxField";
+import { TextField } from "../ui/Field";
+import { InlineMessage } from "../ui/InlineMessage";
+import { Section } from "../ui/Section";
+import type { useMcpSettings } from "./useMcpSettings";
+import styles from "./McpSettingsView.module.css";
+
+type Props = ReturnType<typeof useMcpSettings>;
+export function McpSettingsView(props: Props): React.JSX.Element {
+  const { t } = useTranslation("components");
+  const { status, error } = props;
+  if (!status)
+    return (
+      <InlineMessage
+        title={error ?? t("mcp.loading")}
+        variant={error ? "danger" : "info"}
+      />
+    );
+  return (
+    <div className={styles.root}>
+      <p>{t("mcp.description")}</p>
+      {error || status.message ? (
+        <InlineMessage
+          title={t("mcp.problem")}
+          detail={error ?? status.message}
+          variant="danger"
+        />
+      ) : null}
+      <McpServerControls {...props} status={status} />
+      <McpPermissions {...props} status={status} />
+      <McpConnections {...props} status={status} />
+      {props.diagnostics ? (
+        <Section divided title={t("mcp.diagnostics")}>
+          {props.diagnostics.checks.map((check) => (
+            <p key={check.name}>
+              {check.passed ? "✓" : "✗"} {check.name}: {check.message}
+            </p>
+          ))}
+        </Section>
+      ) : null}
+    </div>
+  );
+}
+type ReadyProps = Props & { status: NonNullable<Props["status"]> };
+function McpServerControls({
+  status,
+  busy,
+  enable,
+  help,
+  pair,
+  copy,
+  diagnose,
+}: ReadyProps): React.JSX.Element {
+  const { t } = useTranslation("components");
+  const running = status.state === "online" || status.state === "starting";
+  return (
+    <Section title={t("mcp.server")} description={t("mcp.provider")}>
+      <div className={styles.controls}>
+        <CheckboxField
+          variant="switch"
+          label={t("mcp.enable")}
+          checked={running}
+          disabled={status.state === "stopping" || (busy && !running)}
+          onCheckedChange={enable}
+        />
+        <span role="status">{t(`mcp.state.${status.state}`)}</span>
+      </div>
+      <TextField
+        label={t("mcp.address")}
+        value={status.url ?? ""}
+        placeholder={t("mcp.addressPending")}
+        readOnly
+      />
+      <div className={styles.controls}>
+        <Button disabled={!status.url || busy} onClick={copy}>
+          {t("mcp.copy")}
+        </Button>
+        <Button disabled={busy || status.state !== "online"} onClick={pair}>
+          {t("mcp.pair")}
+        </Button>
+        <Button disabled={busy || status.state !== "online"} onClick={diagnose}>
+          {t("mcp.diagnostics")}
+        </Button>
+        <Button onClick={() => help("chatgpt")}>{t("mcp.chatgpt")}</Button>
+        <Button onClick={() => help("download")}>{t("mcp.install")}</Button>
+        {status.setupUrl ? (
+          <Button variant="primary" onClick={() => help("setup")}>
+            {t("mcp.setup")}
+          </Button>
+        ) : null}
+      </div>
+      {status.pairingUntil ? (
+        <InlineMessage
+          title={t("mcp.pairingOpen")}
+          detail={t("mcp.pairingHelp")}
+        />
+      ) : null}
+      <p className={styles.note}>{t("mcp.offHelp")}</p>
+    </Section>
+  );
+}
+function McpPermissions({
+  status,
+  busy,
+  configure,
+}: ReadyProps): React.JSX.Element {
+  const { t } = useTranslation("components");
+  const disabled = busy || !["off", "error"].includes(status.state);
+  return (
+    <Section
+      divided
+      title={t("mcp.permissions")}
+      description={t("mcp.permissionsHelp")}
+    >
+      <div className={styles.options}>
+        <CheckboxField
+          checked={status.preferences.allowImages}
+          disabled={disabled}
+          onCheckedChange={(allowImages) =>
+            configure({ ...status.preferences, allowImages })
+          }
+          label={t("mcp.images")}
+        />
+        <CheckboxField
+          checked={status.preferences.allowEditing}
+          disabled={disabled}
+          onCheckedChange={(allowEditing) =>
+            configure({ ...status.preferences, allowEditing })
+          }
+          label={t("mcp.edits")}
+        />
+        <CheckboxField
+          checked={status.preferences.autoStart}
+          disabled={disabled}
+          onCheckedChange={(autoStart) =>
+            configure({ ...status.preferences, autoStart })
+          }
+          label={t("mcp.autoStart")}
+        />
+      </div>
+      <p className={styles.note}>{t("mcp.privacy")}</p>
+    </Section>
+  );
+}
+function McpConnections({
+  status,
+  busy,
+  resolve,
+  revoke,
+}: ReadyProps): React.JSX.Element {
+  const { t } = useTranslation("components");
+  return (
+    <Section
+      divided
+      title={t("mcp.connections")}
+      description={t("mcp.approvalHelp")}
+    >
+      {status.pending.map((request) => (
+        <div className={styles.connection} key={request.id}>
+          <div>
+            <strong>{request.clientName}</strong>
+            <p className={styles.code}>{request.code}</p>
+            <p>{request.scope}</p>
+          </div>
+          <div className={styles.controls}>
+            <Button disabled={busy} onClick={() => resolve(request.id, false)}>
+              {t("mcp.deny")}
+            </Button>
+            <Button
+              variant="primary"
+              disabled={busy}
+              onClick={() => resolve(request.id, true)}
+            >
+              {t("mcp.approve")}
+            </Button>
+          </div>
+        </div>
+      ))}
+      {status.connections.length === 0 ? (
+        <p className={styles.note}>{t("mcp.empty")}</p>
+      ) : null}
+      {status.connections.map((connection) => (
+        <div className={styles.connection} key={connection.id}>
+          <div>
+            <strong>{connection.clientName}</strong>
+            <p>{connection.scope}</p>
+            <span>
+              {connection.revoked ? t("mcp.revoked") : t("mcp.remembered")}
+            </span>
+          </div>
+          <Button
+            disabled={
+              busy ||
+              connection.revoked ||
+              status.state === "starting" ||
+              status.state === "stopping"
+            }
+            onClick={() => revoke(connection.id)}
+          >
+            {t("mcp.revoke")}
+          </Button>
+        </div>
+      ))}
+    </Section>
+  );
+}
