diff --git a/src/renderer/src/components/settingsModal/useMcpSettings.ts b/src/renderer/src/components/settingsModal/useMcpSettings.ts
new file mode 100644
--- /dev/null
+++ b/src/renderer/src/components/settingsModal/useMcpSettings.ts
@@ -0,0 +1,91 @@
+import React from "react";
+import { mcpGateway } from "../../api/mcpGateway";
+import type {
+  McpDesktopStatus,
+  McpDiagnostics,
+} from "../../../../shared/mcpDesktopTypes";
+
+export function useMcpSettings() {
+  const [status, setStatus] = React.useState<McpDesktopStatus | null>(null);
+  const [busy, setBusy] = React.useState(false);
+  const [error, setError] = React.useState<string | null>(null);
+  const [diagnostics, setDiagnostics] = React.useState<McpDiagnostics | null>(
+    null,
+  );
+  const epoch = React.useRef(0);
+  React.useEffect(() => {
+    let active = true;
+    let timer: ReturnType<typeof setTimeout>;
+    async function poll() {
+      const current = epoch.current;
+      try {
+        const next = await mcpGateway.getMcpStatus();
+        if (active && current === epoch.current) setStatus(next);
+      } catch (failure) {
+        if (active) setError(errorMessage(failure));
+      } finally {
+        if (active)
+          timer = setTimeout(() => {
+            void poll();
+          }, 1000);
+      }
+    }
+    void poll();
+    return () => {
+      active = false;
+      clearTimeout(timer);
+    };
+  }, []);
+  async function run(action: () => Promise<McpDesktopStatus | void>) {
+    ++epoch.current;
+    setBusy(true);
+    setError(null);
+    try {
+      const next = await action();
+      if (next) setStatus(next);
+    } catch (failure) {
+      setError(errorMessage(failure));
+    } finally {
+      ++epoch.current;
+      setBusy(false);
+    }
+  }
+  return {
+    status,
+    busy,
+    error,
+    diagnostics,
+    enable: (value: boolean) => {
+      void run(() => mcpGateway.setMcpEnabled(value));
+    },
+    configure: (value: McpDesktopStatus["preferences"]) => {
+      void run(() => mcpGateway.configureMcp(value));
+    },
+    pair: () => {
+      void run(() => mcpGateway.beginMcpPairing());
+    },
+    resolve: (id: string, approved: boolean) => {
+      void run(() => mcpGateway.resolveMcpPairing(id, approved));
+    },
+    revoke: (id: string) => {
+      void run(() => mcpGateway.revokeMcpConnection(id));
+    },
+    help: (target: "download" | "setup" | "chatgpt") => {
+      void run(() => mcpGateway.openMcpHelp(target));
+    },
+    copy: () => {
+      void run(async () => {
+        if (status?.url) await navigator.clipboard.writeText(status.url);
+      });
+    },
+    diagnose: () => {
+      void run(async () => {
+        setDiagnostics(await mcpGateway.diagnoseMcp());
+      });
+    },
+  };
+}
+
+function errorMessage(error: unknown): string {
+  return error instanceof Error ? error.message : String(error);
+}
